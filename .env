# QuickFund-X — root environment reference
#
# Docker Compose reads per-service values from this file (via `env_file` /
# `environment` in docker-compose.yml). Copy to `.env` for local runs:
#   cp .env.example .env
# Real secrets must NEVER be committed. This file only holds safe local-dev
# defaults / placeholders (see SECURITY.md for production key management
# and rotation guidance, added in Phase 9/25).

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
APP_ENV=development

# ---------------------------------------------------------------------------
# Loan Platform A — QuickFund
# ---------------------------------------------------------------------------
LOAN_A_PORT=4001
LOAN_A_MONGO_PORT=27018
LOAN_A_MONGO_URI=mongodb://mongo-loan-a:27017/loan_platform_a
LOAN_A_JWT_SECRET=change-me-loan-platform-a-jwt-secret
LOAN_A_CENTRAL_API_KEY=change-me-shared-secret-a

# ---------------------------------------------------------------------------
# Loan Platform B — TrustLend
# ---------------------------------------------------------------------------
LOAN_B_PORT=4002
LOAN_B_MONGO_PORT=27019
LOAN_B_MONGO_URI=mongodb://mongo-loan-b:27017/loan_platform_b
LOAN_B_JWT_SECRET=change-me-loan-platform-b-jwt-secret
LOAN_B_CENTRAL_API_KEY=change-me-shared-secret-b

# ---------------------------------------------------------------------------
# Loan Platform C — SecureCredit
# ---------------------------------------------------------------------------
LOAN_C_PORT=4003
LOAN_C_MONGO_PORT=27020
LOAN_C_MONGO_URI=mongodb://mongo-loan-c:27017/loan_platform_c
LOAN_C_JWT_SECRET=change-me-loan-platform-c-jwt-secret
LOAN_C_CENTRAL_API_KEY=change-me-shared-secret-c

# ---------------------------------------------------------------------------
# Loan Platform D — FinBridge
# ---------------------------------------------------------------------------
LOAN_D_PORT=4004
LOAN_D_MONGO_PORT=27021
LOAN_D_MONGO_URI=mongodb://mongo-loan-d:27017/loan_platform_d
LOAN_D_JWT_SECRET=change-me-loan-platform-d-jwt-secret
LOAN_D_CENTRAL_API_KEY=change-me-shared-secret-d

# ---------------------------------------------------------------------------
# Central Fraud Intelligence + GNN application
# ---------------------------------------------------------------------------
CENTRAL_PORT=5000
CENTRAL_DB_PORT=5433
CENTRAL_DB_URI=postgresql://quickfundx:change-me-central-db-password@central-db:5432/central_fraud_intelligence
CENTRAL_DB_USER=quickfundx
CENTRAL_DB_PASSWORD=change-me-central-db-password
CENTRAL_DB_NAME=central_fraud_intelligence

# Master key that all per-purpose HMAC tokenization keys (name/phone/email/
# address/device/bank) are derived from via HKDF. Phase 9. Consumed by ALL
# FIVE services (loan-platform-a/b/c/d AND central-fraud-intelligence — see
# docker-compose.yml, where this one value is injected into every service's
# environment block) because the same real-world value must tokenize to the
# same value no matter which platform computes it, for cross-platform
# entity resolution (Phase 10+) to work at all. NOT per-platform-suffixed.
CENTRAL_HMAC_MASTER_KEY=change-me-32-byte-minimum-master-key-value

# AES-256-GCM key for transient sensitive-payload field encryption. Phase 9.
# Also shared by all five services for the same reason as above — a loan
# platform encrypts, only the central app ever decrypts (Phase 17+
# investigator workflow).
CENTRAL_AES_KEY=change-me-32-byte-aes-256-gcm-key

# JWT secret for the central app's OWN admin auth only (src/security/
# jwt_auth.py). Phase 9. Unlike the two keys above, this is NOT shared with
# the loan platforms — each platform already has its own JWT_SECRET_* for
# its own users/admins (see LOAN_A_JWT_SECRET etc. above).
CENTRAL_JWT_SECRET=change-me-central-jwt-secret

# Shared API keys the central app trusts from each platform (mirrors the
# *_CENTRAL_API_KEY values above — must match per platform). Phase 9.
CENTRAL_ACCEPTS_API_KEY_A=change-me-shared-secret-a
CENTRAL_ACCEPTS_API_KEY_B=change-me-shared-secret-b
CENTRAL_ACCEPTS_API_KEY_C=change-me-shared-secret-c
CENTRAL_ACCEPTS_API_KEY_D=change-me-shared-secret-d

# Phase 18: base URLs the notification delivery worker (src/notifications/
# worker.py) POSTs fraud alerts to, one per platform. Already match
# src/config.py's own defaults (each platform's in-network DNS name on
# net-central-bus, port 4000 — the container port every loan platform
# listens on internally, NOT the host-side LOAN_*_PORT mapping above), so
# these are optional overrides, not required for a normal docker-compose
# run — listed explicitly so a deployment that renames or relocates a
# service doesn't have to go spelunking in src/config.py to find what to
# override. The outbound API key reused to authenticate each of these
# requests is CENTRAL_ACCEPTS_API_KEY_{A,B,C,D} above, not a new secret.
PLATFORM_A_BASE_URL=http://loan-platform-a:4000
PLATFORM_B_BASE_URL=http://loan-platform-b:4000
PLATFORM_C_BASE_URL=http://loan-platform-c:4000
PLATFORM_D_BASE_URL=http://loan-platform-d:4000
